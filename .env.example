# Señal TVN — configuración local. Copiado a .env por server_start si no existe.
# NUNCA subas .env al repositorio: puede contener credenciales.

# Puerto del servidor web local.
SENAL_PUERTO=8765

# Redacción de borradores (el LLM solo redacta; nunca prioriza ni decide verdad).
#   ollama   → Ollama local (por defecto; sin internet). Si no responde, plantilla extractiva.
#   vacío    → Gemini si hay GEMINI_API_KEY o AI_API_KEY; si no, Ollama local si responde;
#              si no, plantilla extractiva (sin LLM, funciona offline).
#   gemini | ollama | ninguno
SENAL_LLM=ollama

# Credencial de Gemini (opcional). Vive solo en el servidor; nunca va al prompt ni a logs.
# Compatible con GEMINI_API_KEY y AI_API_KEY
GEMINI_API_KEY=
SENAL_GEMINI_MODELO=gemini-flash-latest

# Compatibilidad alternativa con variables genéricas (solo se usa si SENAL_LLM está vacío)
AI_PROVIDER=
AI_API_KEY=

# Ollama local (funciona sin internet). Antes: instalar Ollama y `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
SENAL_OLLAMA_MODELO=llama3.2

# Tarifas para el costo medido por consulta (USD por millón de tokens). 0 en local.
SENAL_TARIFA_ENTRADA_USD_1M=0
SENAL_TARIFA_SALIDA_USD_1M=0

# Embeddings multilingües en proceso. Se descargan una vez y quedan en caché.
SENAL_MODELO_EMBEDDINGS=intfloat/multilingual-e5-small
# 1 = arrancar sin modelo (solo BM25 y palabras clave, rotulado en la interfaz).
SENAL_SIN_MODELO=0
